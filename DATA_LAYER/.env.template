# =============================================================================
# NWIS - Nearby Wells Intelligence System
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from your Supabase project dashboard: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Database connection (for direct PostgreSQL access if needed)
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# -----------------------------------------------------------------------------
# CHROMADB CONFIGURATION
# -----------------------------------------------------------------------------
# For local ChromaDB (default)
CHROMADB_MODE=persistent
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PERSIST_DIR=./data/chromadb

# For ChromaDB Cloud (if using managed service)
# CHROMADB_API_KEY=your-chromadb-api-key
# CHROMADB_TENANT=your-tenant
# CHROMADB_DATABASE=your-database

# -----------------------------------------------------------------------------
# NEO4J KNOWLEDGE GRAPH CONFIGURATION
# -----------------------------------------------------------------------------
# For local Neo4j (default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# For Neo4j Aura, use the neo4j+s:// scheme and the credentials from the
# connection details shown in the Aura console.

# -----------------------------------------------------------------------------
# DOCUMENT STORAGE (Object Storage)
# -----------------------------------------------------------------------------
# Supabase Storage bucket for PDFs and extracted artifacts
SUPABASE_STORAGE_BUCKET=well-documents
SUPABASE_STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Alternative: AWS S3 / MinIO
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=well-documents
# S3_ENDPOINT_URL=  # For MinIO

# -----------------------------------------------------------------------------
# EMBEDDING MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# Local CPU-compatible embedding model
# Options: 
# - sentence-transformers/all-MiniLM-L6-v2 (384 dim, fast, good quality)
# - sentence-transformers/all-mpnet-base-v2 (768 dim, better quality, slower)
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (multilingual)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# -----------------------------------------------------------------------------
# OCR CONFIGURATION
# -----------------------------------------------------------------------------
# Tesseract path (Windows default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# For Linux/Mac: TESSERACT_CMD=/usr/bin/tesseract

# PaddleOCR settings (alternative, better for tables)
PADDLEOCR_USE_GPU=false
PADDLEOCR_LANG=en
PADDLEOCR_DET_MODEL_DIR=./models/paddleocr/det
PADDLEOCR_REC_MODEL_DIR=./models/paddleocr/rec

# -----------------------------------------------------------------------------
# NLP / SPACY CONFIGURATION
# -----------------------------------------------------------------------------
SPACY_MODEL=en_core_web_lg
# For custom trained model: SPACY_MODEL=./models/custom_ner

# -----------------------------------------------------------------------------
# REAL-TIME DATA (eRTMAC) CONFIGURATION
# -----------------------------------------------------------------------------
ERTMAC_API_ENDPOINT=http://localhost:8080/api/v1
ERTMAC_WS_ENDPOINT=ws://localhost:8080/ws
ERTMAC_API_KEY=your-ertmac-api-key
ERTMAC_POLL_INTERVAL_SECONDS=5

# InfluxDB for time-series (if using separate TSDB)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=drilling-data

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# API Security
API_SECRET_KEY=your-super-secret-key-change-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# -----------------------------------------------------------------------------
# RETRIEVAL CONFIGURATION
# -----------------------------------------------------------------------------
# Hybrid retrieval weights (sum should = 1.0)
RETRIEVAL_WEIGHT_GRAPH=0.30
RETRIEVAL_WEIGHT_VECTOR=0.30
RETRIEVAL_WEIGHT_SQL=0.20
RETRIEVAL_WEIGHT_SPATIAL=0.10
RETRIEVAL_WEIGHT_DEPTH=0.10

# Search defaults
RETRIEVAL_DEFAULT_SEARCH_RADIUS_KM=5.0
RETRIEVAL_DEFAULT_DEPTH_TOLERANCE_M=50
RETRIEVAL_DEFAULT_TOP_K=20
RETRIEVAL_RERANK_TOP_K=10

# -----------------------------------------------------------------------------
# INGESTION PIPELINE CONFIGURATION
# -----------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_LENGTH=100
MAX_CHUNK_LENGTH=2000

# Confidence thresholds
OCR_CONFIDENCE_THRESHOLD=0.7
ENTITY_EXTRACTION_CONFIDENCE=0.8
RELATION_EXTRACTION_CONFIDENCE=0.75
EVENT_EXTRACTION_CONFIDENCE=0.8

# Validation
REQUIRE_ENGINEER_VALIDATION=true
AUTO_VALIDATE_HIGH_CONFIDENCE=0.95

# -----------------------------------------------------------------------------
# LOGGING AND MONITORING
# -----------------------------------------------------------------------------
LOG_FORMAT=json
LOG_DIR=./logs
METRICS_ENABLED=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_REAL_TIME_ALERTS=true
ENABLE_GRAPH_EXPANSION=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_LLM_RAG=true
ENABLE_ANALOGUE_MATCHING=true

# Knowledge graph backend: local (offline NetworkX) | neo4j | auto
# auto uses Neo4j when reachable, otherwise the offline local graph.
GRAPH_BACKEND=auto
